# Copy to .env and fill in. Never commit .env.
# Empty values use the defaults shown in app/core/config.py.

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Upload limits
MAX_UPLOAD_MB=5
MAX_IMAGE_DIMENSION=2048

# Rate limiting: <number>/<second|minute|hour|day>
RATE_LIMIT_ANALYZE=10/minute

# CORS: comma-separated frontend URLs
CORS_ORIGINS=http://localhost:5173

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Shared daily cap on all AI calls (0 = off). For Gemini Flash-Lite free tier, e.g. 400.
AI_DAILY_LIMIT=0
